# Copy to .env for local dev (`netlify dev`), and set the same vars in the
# Netlify UI: Site settings → Environment variables.

# Firebase Admin service account (Project settings → Service accounts →
# "Generate new private key"). Paste the ENTIRE downloaded JSON on one line,
# single-quoted. This is a SECRET — never commit the real value.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"draft-hub-bece4", ...}'

# Realtime Database URL (Firebase console → Realtime Database).
FIREBASE_DB_URL=https://draft-hub-bece4-default-rtdb.firebaseio.com

# Optional: shared secret to require on manual (?key=...) HTTP invocations of
# the update-scores function. Leave unset to allow unauthenticated GETs.
SCORES_REFRESH_KEY=
